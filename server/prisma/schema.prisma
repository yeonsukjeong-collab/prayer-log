generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id        String   @id @default(uuid())
  name      String   @unique
  isLeader  Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  prayerRequests PrayerRequest[]
  prayerTexts    PrayerText[]
  photos         Photo[]
  benedictions   Benediction[]
  pastorPrayers  PastorPrayer[]

  @@map("prayer_log_members")
}

model PrayerRequest {
  id           String    @id @default(uuid())
  content      String
  requestDate  DateTime  @default(now())
  isAnswered   Boolean   @default(false)
  answeredNote String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([requestDate])
  @@map("prayer_log_prayer_requests")
}

model PrayerText {
  id          String   @id @default(uuid())
  title       String
  content     String
  meetingDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([meetingDate])
  @@map("prayer_log_prayer_texts")
}

model Photo {
  id            String   @id @default(uuid())
  caption       String?
  photoDate     DateTime @default(now())
  thumbnailData String   @db.Text
  imageData     String   @db.Text
  createdAt     DateTime @default(now())

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([photoDate])
  @@map("prayer_log_photos")
}

model Benediction {
  id        String   @id @default(uuid())
  content   String
  updatedAt DateTime @updatedAt

  updatedById String
  updatedBy   Member @relation(fields: [updatedById], references: [id], onDelete: Cascade)

  @@map("prayer_log_benediction")
}

model PastorPrayer {
  id         String   @id @default(uuid())
  content    String
  prayerDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recordedById String
  recordedBy   Member @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([prayerDate])
  @@map("prayer_log_pastor_prayers")
}
