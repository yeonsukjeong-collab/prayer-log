generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id        String   @id @default(uuid())
  name      String   @unique
  isLeader  Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  prayerRequests PrayerRequest[]
  prayerTexts    PrayerText[]
  photos         Photo[]
  photoComments  PhotoComment[]
  benedictions   Benediction[]
  pastorPrayers  PastorPrayer[]
  meditations    Meditation[]

  @@map("prayer_log_members")
}

model PrayerRequest {
  id           String    @id @default(uuid())
  content      String
  requestDate  DateTime  @default(now())
  isAnswered   Boolean   @default(false)
  answeredNote String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([requestDate])
  @@map("prayer_log_prayer_requests")
}

model PrayerText {
  id          String   @id @default(uuid())
  title       String
  content     String
  meetingDate DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([meetingDate])
  @@map("prayer_log_prayer_texts")
}

model Photo {
  id            String   @id @default(uuid())
  caption       String?
  photoDate     DateTime @default(now())
  // 구글 드라이브로 옮기기 전의 사진은 여기에 이미지가 들어 있습니다. 드라이브에 올린 새 사진은 빈 문자열입니다.
  thumbnailData String   @db.Text
  imageData     String   @db.Text
  // 구글 드라이브에 올린 사진 파일 ID. 있으면 화면에는 드라이브의 사진을 보여줍니다.
  driveFileId   String?
  createdAt     DateTime @default(now())

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  comments PhotoComment[]

  @@index([authorId])
  @@index([photoDate])
  @@map("prayer_log_photos")
}

model PhotoComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([photoId])
  @@map("prayer_log_photo_comments")
}

model Benediction {
  id        String   @id @default(uuid())
  content   String
  updatedAt DateTime @updatedAt

  updatedById String
  updatedBy   Member @relation(fields: [updatedById], references: [id], onDelete: Cascade)

  @@map("prayer_log_benediction")
}

// 화면에서는 말씀 묵상으로 대체되었지만, 기존 기도문을 보존하기 위해 테이블은 남겨둡니다.
model PastorPrayer {
  id         String   @id @default(uuid())
  content    String
  prayerDate DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  recordedById String
  recordedBy   Member @relation(fields: [recordedById], references: [id], onDelete: Cascade)

  @@index([prayerDate])
  @@map("prayer_log_pastor_prayers")
}

model Meditation {
  id         String   @id @default(uuid())
  book       String
  chapter    Int
  verseStart Int
  verseEnd   Int?
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorId String
  author   Member @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([createdAt])
  @@map("prayer_log_meditations")
}

// 성경퀴즈에서 최근에 낸 문제입니다. 같은 범위로 다시 출제할 때 겹치지 않게 피하는 데 씁니다.
model QuizHistory {
  id        String   @id @default(uuid())
  scope     String
  question  String
  createdAt DateTime @default(now())

  @@index([scope, createdAt])
  @@map("prayer_log_quiz_history")
}
