PORT=3000
NODE_ENV=development

# Render Postgres connection string (Internal or External Database URL from Render dashboard)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# 목장원이 모두 함께 사용할 공유 암호
ACCESS_PASSWORD=change-me

# 목자(isLeader) 전용 암호. 비워두면 목자도 공유 암호로 로그인합니다.
LEADER_PASSWORD=

# 성경퀴즈 문제를 만드는 Claude API 키 (https://platform.claude.com 의 API Keys). 비워두면 성경퀴즈만 동작하지 않습니다.
ANTHROPIC_API_KEY=

# Any long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET=change-me

# URL of the frontend during local dev (Vite default)
CLIENT_URL=http://localhost:5173
